# Gemini API Key (Required)
# Get your free API key at: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Native resume import AI timeout in milliseconds (Optional)
# Default: 90000. Allowed range: 30000-180000.
RESUME_IMPORT_TIMEOUT_MS=90000

# Final resume generation AI timeout in milliseconds (Optional)
# Default: 120000. Allowed range: 30000-240000.
RESUME_GENERATION_TIMEOUT_MS=120000

# Application URL (Optional)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Inert G8 compatibility sentinel. Native resume import does not read or call n8n.
# Kept temporarily so the historical browser-isolation regression remains valid.
N8N_RESUME_URL=

# Inline Optimize is routed internally by next.config.js to /api/optimize-content.
# This legacy variable is no longer operator-configurable and should remain unset.
NEXT_PUBLIC_N8N_OPTIMIZE_URL=

# Legacy browser suggestion integration pending later removal/security hardening.
NEXT_PUBLIC_N8N_ADD_SUGGESTIONS_URL=

# Rate limiting backend (Optional)
# auto/default: process memory in local development; Upstash Redis in production
# when server-side credentials exist. Use `redis` only when you intentionally
# want local development to exercise the distributed limiter.
# Values: auto | memory | redis
RATE_LIMIT_BACKEND=auto

# Durable Redis persistence (Required for trusted Career Vault / Career Target /
# Opportunity history and market decision state).
# The endpoint and token must belong to a live Upstash database. Durable flows
# perform a readiness probe before expensive work and still verify every commit
# by their domain-specific save/reload integrity contract. There is deliberately
# no process-memory fallback for trusted durable state.
# Rate limiting may use the same Redis according to RATE_LIMIT_BACKEND.
# Never expose these values as NEXT_PUBLIC_* variables.
# Create/select a database at: https://console.upstash.com/
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
