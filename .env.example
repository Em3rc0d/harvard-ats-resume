# Public Supabase project configuration. The publishable key is intentionally browser-safe.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_example

# Server-only AI platform secret. Never prefix with NEXT_PUBLIC_.
GEMINI_API_KEY=

# Optional Ollama fallback endpoint. Local dev can use http://127.0.0.1:11434.
OLLAMA_BASE_URL=
OLLAMA_API_KEY=
