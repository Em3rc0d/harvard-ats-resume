# Local AI runtime (Required)
# CV Engine no longer requires Gemini or another remote LLM provider.
# Workloads intentionally use different local model sizes:
# - resume import v3: qwen3:1.7b over bounded source sections
# - inline rewrite: qwen3:4b-instruct
# - final resume generation: qwen3:8b
# Host-run development default:
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_IMPORT_MODEL=qwen3:1.7b
OLLAMA_RESUME_MODEL=qwen3:8b
OLLAMA_OPTIMIZE_MODEL=qwen3:4b-instruct

# Docker import v3 model. Docker Compose intentionally reads this dedicated
# variable instead of OLLAMA_IMPORT_MODEL so stale v2 qwen3:8b settings cannot
# silently reactivate the monolithic import workload.
DOCKER_OLLAMA_IMPORT_MODEL=qwen3:1.7b

# Ollama context window. Default: 16384. Allowed range: 4096-65536.
OLLAMA_NUM_CTX=16384

# Resume import outer timeout budget in milliseconds (Optional).
# Import v3 additionally caps each bounded section request at 90000 ms so one
# pathological extraction cannot occupy the local model indefinitely.
# Allowed range inherited from the import boundary: 30000-300000.
RESUME_IMPORT_TIMEOUT_MS=180000

# Final resume generation AI timeout in milliseconds (Optional)
# Local CPU inference is bounded at 240 seconds by default.
# Allowed range: 30000-360000.
RESUME_GENERATION_TIMEOUT_MS=240000

# Docker-specific execution budgets. Compose uses these instead of stale
# RESUME_* values that may remain in an older local .env from the Gemini era.
DOCKER_RESUME_IMPORT_TIMEOUT_MS=180000
DOCKER_RESUME_GENERATION_TIMEOUT_MS=240000

# Keep local model memory predictable on laptops/desktops.
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_NUM_PARALLEL=1

# Application URL (Optional)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Inert compatibility sentinel. Native resume import does not read or call n8n.
N8N_RESUME_URL=

# Inline Optimize is routed internally by next.config.js to /api/optimize-content.
NEXT_PUBLIC_N8N_OPTIMIZE_URL=

# Legacy browser suggestion integration pending later removal/security hardening.
NEXT_PUBLIC_N8N_ADD_SUGGESTIONS_URL=

# Rate limiting backend (Optional)
# auto/default: process memory in host-run local development; Redis in production
# when server-side credentials exist. Docker Compose configures local Redis.
# Values: auto | memory | redis
RATE_LIMIT_BACKEND=auto

# Durable Redis persistence (Required for trusted Career Vault / Career Target /
# Opportunity history and market decision state).
# These variable names remain because CV Engine uses the @upstash/redis REST
# protocol. They can point either to Upstash Cloud or to the local compatible
# REST proxy included in docker-compose.yml.
# Never expose these values as NEXT_PUBLIC_* variables.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Docker-only local Redis REST token. docker-compose.yml uses this value for the
# local Upstash-compatible proxy. Change it outside throwaway development.
LOCAL_REDIS_TOKEN=cv-engine-local-change-me
