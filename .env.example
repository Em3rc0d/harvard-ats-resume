# Public Supabase project configuration. The publishable key is intentionally browser-safe.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_example

# Private/internal platform AI only. Public users are not entitled to this key.
# Keep disabled in public production unless an explicit allowlisted/internal flow needs it.
GEMINI_API_KEY=
CVENGINE_ALLOW_PLATFORM_AI=0

# Optional BYOK model overrides. The user's own provider key pays provider usage.
# Leave blank to use the release-qualified defaults in AIGatewayFoundation.
CVENGINE_GEMINI_BYOK_MODEL=
CVENGINE_OPENAI_BYOK_MODEL=
CVENGINE_ANTHROPIC_BYOK_MODEL=

# Optional provider-compatible base URL overrides.
GEMINI_API_BASE_URL=
OPENAI_API_BASE_URL=
ANTHROPIC_API_BASE_URL=

# Optional server/local-development Ollama fallback. Browser Local AI does not use this endpoint.
OLLAMA_BASE_URL=
OLLAMA_API_KEY=
